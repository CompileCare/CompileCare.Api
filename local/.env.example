# Copy to local/.env. Configure an OIDC provider with this web redirect URI.
OIDC_AUTHORITY=https://your-identity-provider.example.com/
OIDC_AUDIENCE=compilecare-api
OIDC_CLIENT_ID=compilecare-web
OIDC_SCOPE=openid profile
OIDC_REQUIRE_HTTPS_METADATA=true

# Local-only database password. Change if port 5432 is shared.
POSTGRES_PASSWORD=compilecare-local-only

# Usually leave this unchanged; launcher clones CompileCare.Web beside CompileCare.Api.
COMPILECARE_WEB_PATH=../../CompileCare.Web
